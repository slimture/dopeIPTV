recordings/
.aider*
# Built-in TMDB key - never commit the real key to the public repo.
# Provide it via the DOPEIPTV_TMDB_KEY env var (CI secret for releases)
# or a local copy of this module made from _tmdb_key.py.example.
dopeiptv/_tmdb_key.py
# The same for the built-in OpenSubtitles key (_opensubtitles_key.py.example).
dopeiptv/_opensubtitles_key.py
# And the built-in Simkl client id (_simkl_key.py.example).
dopeiptv/_simkl_key.py
# Helper worktrees of a coding assistant, never part of the repo.
.claude/worktrees/
# The signed list of a build's own files, made in the build only
# (tools/build_manifest.py, dopeiptv/core/build_check.py).
dopeiptv/_build_manifest.json
dopeiptv/_build_manifest.json.sig
