#!/bin/sh
#
# PROVIDE: iptv_donate
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# The donate dialog's small service for iptv.dope.rs (donate/donate.py).
# Install as /usr/local/etc/rc.d/iptv_donate (mode 555) inside the jail, then:
#
#   sysrc iptv_donate_enable=YES
#   service iptv_donate start
#
# daemon(8) restarts it if it ever stops, and reopens the log on SIGHUP (-H)
# - newsyslog turns it over and sends that (DEPLOY.md, "Hardening,
# November 2026"). Without -H daemon does not catch a SIGHUP, which can end
# it and leave the service unwatched: newsyslog's line comes only after
# this file is in place and the service restarted with it.

. /etc/rc.subr

name=iptv_donate
rcvar=iptv_donate_enable

load_rc_config $name

: ${iptv_donate_enable:=NO}
: ${iptv_donate_user:=iptv}
: ${iptv_donate_socket_group:=www}
: ${iptv_donate_python:=/usr/local/bin/python3}
: ${iptv_donate_script:=/usr/local/www/iptv/donate/donate.py}
: ${iptv_donate_log:=/var/log/iptv-donate.log}

# rc.subr runs the command as ${iptv_donate_user} (su -m) because that
# variable is set, so daemon(8) needs no -u of its own: given one, it tried
# to switch users again without root ("failed to set user environment").
# Running as that user, it can only write its pidfile into a directory of
# that user's, made here as root before the start ("Permission denied" in
# /var/run itself). The service's socket is there too: the folder is the
# service's and nginx's workers' group's (iptv_donate_socket_group, www -
# the service's SOCKET_GROUP names the same), 0750, so only they reach the
# socket in it (0660, made there with the folder's group); it was 0755
# around a socket anyone in the jail could connect to.
piddir=/var/run/${name}
pidfile=${piddir}/${name}.pid
command=/usr/sbin/daemon
command_args="-R 5 -H -P ${pidfile} -o ${iptv_donate_log} ${iptv_donate_python} -I ${iptv_donate_script}"
start_precmd=iptv_donate_precmd

iptv_donate_precmd()
{
	install -d -o "${iptv_donate_user}" -g "${iptv_donate_socket_group}" -m 750 "${piddir}"
}

run_rc_command "$1"
